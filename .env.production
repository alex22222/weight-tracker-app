# 生产环境配置
# 1. 修改此文件中的敏感信息
# 2. 在 CloudBase 控制台同步配置这些环境变量

# 数据库配置
DB_TYPE=cloudbase
CLOUDBASE_ENV_ID=your-cloudbase-env-id

# 服务端口号
PORT=80
HOSTNAME=0.0.0.0
NODE_ENV=production

# 微信小程序配置
WECHAT_APPID=your-wechat-appid
WECHAT_SECRET=your-wechat-secret

# JWT 密钥（必填！用于 Token 签名）
# 生成方式: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-min-32-characters-change-this
JWT_EXPIRES_IN=7d

# 腾讯云密钥（必填！）
# 从腾讯云控制台获取: https://console.cloud.tencent.com/cam/capi
TENCENT_SECRET_ID=your-tencent-secret-id
TENCENT_SECRET_KEY=your-tencent-secret-key
