/**
 * 设计系统 - Design System
 * 统一视觉规范，确保品牌一致性
 */

/* ========== 色彩规范 Color System ========== */

/* 主色调 - 温暖活力橙 */
:root {
  --primary-50: #fff7ed;
  --primary-100: #ffedd5;
  --primary-200: #fed7aa;
  --primary-300: #fdba74;
  --primary-400: #fb923c;
  --primary-500: #f97316;  /* 主色 */
  --primary-600: #ea580c;
  --primary-700: #c2410c;
}

/* 中性色 */
:root {
  --gray-50: #f8fafc;
  --gray-100: #f1f5f9;
  --gray-200: #e2e8f0;
  --gray-300: #cbd5e1;
  --gray-400: #94a3b8;
  --gray-500: #64748b;
  --gray-600: #475569;
  --gray-700: #334155;
  --gray-800: #1e293b;  /* 主文字 */
  --gray-900: #0f172a;
}

/* 功能色 */
:root {
  --success-500: #22c55e;
  --warning-500: #f59e0b;
  --error-500: #ef4444;
  --info-500: #3b82f6;
}

/* ========== 字体规范 Typography ========== */

/* 字体层级 */
.text-display {    /* 大标题 */
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--gray-800);
}

.text-title {      /* 页面标题 */
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--gray-800);
}

.text-subtitle {   /* 副标题 */
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--gray-700);
}

.text-body {       /* 正文 */
  font-size: 28rpx;
  font-weight: 400;
  line-height: 1.5;
  color: var(--gray-600);
}

.text-caption {    /* 辅助文字 */
  font-size: 24rpx;
  font-weight: 400;
  line-height: 1.5;
  color: var(--gray-500);
}

.text-small {      /* 小字 */
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.4;
  color: var(--gray-400);
}

/* ========== 间距规范 Spacing ========== */

:root {
  --space-xs: 8rpx;
  --space-sm: 16rpx;
  --space-md: 24rpx;
  --space-lg: 32rpx;
  --space-xl: 48rpx;
  --space-2xl: 64rpx;
}

/* ========== 圆角规范 Border Radius ========== */

:root {
  --radius-sm: 8rpx;    /* 小元素 */
  --radius-md: 12rpx;   /* 按钮、输入框 */
  --radius-lg: 16rpx;   /* 卡片 */
  --radius-xl: 24rpx;   /* 大卡片、面板 */
  --radius-full: 9999rpx; /* 圆形 */
}

/* ========== 阴影规范 Shadows ========== */

.shadow-sm {
  box-shadow: 0 1rpx 2rpx 0 rgba(0, 0, 0, 0.05);
}

.shadow-md {
  box-shadow: 0 4rpx 6rpx -1rpx rgba(0, 0, 0, 0.1), 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.1);
}

.shadow-lg {
  box-shadow: 0 10rpx 15rpx -3rpx rgba(0, 0, 0, 0.1), 0 4rpx 6rpx -4rpx rgba(0, 0, 0, 0.1);
}

.shadow-xl {
  box-shadow: 0 20rpx 25rpx -5rpx rgba(0, 0, 0, 0.1), 0 8rpx 10rpx -6rpx rgba(0, 0, 0, 0.1);
}

/* ========== 通用组件样式 Components ========== */

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: white;
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 14rpx rgba(249, 115, 22, 0.4);
  border: none;
  transition: all 0.2s;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(249, 115, 22, 0.3);
}

.btn-primary::after {
  border: none;
}

/* 次按钮 */
.btn-secondary {
  background: white;
  color: var(--gray-700);
  border-radius: var(--radius-md);
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  border: 2rpx solid var(--gray-200);
}

.btn-secondary::after {
  border: none;
}

/* 卡片 */
.card {
  background: white;
  border-radius: var(--radius-lg);
  padding: var(--space-lg);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

/* 输入框 */
.input {
  background: var(--gray-50);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--gray-800);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.input:focus {
  border-color: var(--primary-300);
  background: white;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: var(--primary-50);
  color: var(--primary-600);
  border-radius: var(--radius-full);
  font-size: 24rpx;
  font-weight: 500;
}

/* ========== 页面布局规范 Layout ========== */

.page-container {
  min-height: 100vh;
  background: var(--gray-50);
  padding: var(--space-md);
}

.section {
  margin-bottom: var(--space-lg);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--gray-800);
  margin-bottom: var(--space-md);
  display: flex;
  align-items: center;
  gap: var(--space-sm);
}

/* ========== 动画 Animations ========== */

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.05); }
}

.animate-fade-in {
  animation: fadeIn 0.3s ease-out;
}

.animate-slide-up {
  animation: slideUp 0.3s ease-out;
}

/* ========== 加载状态 Loading States ========== */
.btn-loading {
  position: relative;
  color: transparent !important;
}

.btn-loading::after {
  content: "";
  position: absolute;
  top: 50%;
  left: 50%;
  width: 32rpx;
  height: 32rpx;
  margin-left: -16rpx;
  margin-top: -16rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 骨架屏加载 */
.skeleton {
  background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  border-radius: var(--radius-md);
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ========== 工具类 Utilities ========== */
.text-center { text-align: center; }
.text-left { text-align: left; }
.text-right { text-align: right; }

.font-bold { font-weight: 700; }
.font-semibold { font-weight: 600; }
.font-medium { font-weight: 500; }
.font-normal { font-weight: 400; }

/* 触摸反馈 */
.touch-feedback {
  transition: transform 0.15s, opacity 0.15s;
}

.touch-feedback:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* 禁用状态 */
.disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 减少动画（无障碍）- WXSS 不支持通配符，故删除 */
