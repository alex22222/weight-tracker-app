<cover-view class="tab-bar">
  <cover-view class="tab-bar-border"></cover-view>
  <cover-view class="tab-bar-item" wx:for="{{tabs}}" wx:for-index="idx" wx:key="key" data-index="{{idx}}" bindtap="switchTab">
    <cover-view class="tab-icon {{idx === selected ? 'active' : ''}}">{{item.icon}}</cover-view>
    <cover-view class="tab-text {{idx === selected ? 'active' : ''}}">{{item.text}}</cover-view>
  </cover-view>
</cover-view>
