<view class="container">
  <!-- 用户信息 -->
  <view class="user-card">
    <view class="user-avatar">{{userInfo.nickname ? userInfo.nickname[0] : userInfo.username ? userInfo.username[0] : '我'}}</view>
    <view class="user-info">
      <text class="user-name">{{userInfo.nickname || userInfo.username || '微信用户'}}</text>
      <text class="user-id" wx:if="{{userInfo.username}}">@{{userInfo.username}}</text>
    </view>
  </view>

  <!-- 设置列表 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToAgreement">
      <text class="menu-icon">📄</text>
      <text class="menu-text">用户协议</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToPrivacy">
      <text class="menu-icon">🔒</text>
      <text class="menu-text">隐私政策</text>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="clearCache">
      <text class="menu-icon">🗑️</text>
      <text class="menu-text">清除缓存</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text>习惯追踪 V2.0.0</text>
  </view>
</view>
