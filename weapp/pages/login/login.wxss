/**pages/login/login.wxss**/

page {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 50%, #fed7aa 100%);
  min-height: 100vh;
}

.container {
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

.login-wrapper {
  max-width: 640rpx;
  margin: 0 auto;
}

/* ========== Logo区域 - 更现代的设计 ========== */
.logo-section {
  text-align: center;
  margin-bottom: 48rpx;
  padding-top: 40rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
  display: inline-block;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

.logo-title {
  font-size: 48rpx;
  font-weight: 800;
  color: #1e293b;
  letter-spacing: -1rpx;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
}

.logo-subtitle {
  font-size: 28rpx;
  color: #64748b;
  margin-top: 12rpx;
  font-weight: 500;
}

/* ========== 功能介绍 - 卡片式布局 ========== */
.features {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 48rpx;
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  background: rgba(255, 255, 255, 0.9);
  padding: 24rpx 28rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(10rpx);
}

.feature-icon {
  font-size: 44rpx;
}

.feature-text {
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}

/* ========== 登录方式切换 - 优化样式 ========== */
.login-tabs {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 40rpx;
  background: rgba(255, 255, 255, 0.6);
  padding: 8rpx;
  border-radius: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  color: #64748b;
  border-radius: 12rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.tab.active {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: white;
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.35);
}

/* ========== 微信登录区域 - 优化卡片 ========== */
.wechat-login-section {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  text-align: center;
  backdrop-filter: blur(10rpx);
}

.wechat-login-desc {
  margin-bottom: 40rpx;
  font-size: 28rpx;
  color: #64748b;
  line-height: 1.6;
}

.wechat-login-desc text {
  display: block;
}

.wechat-login-desc .highlight {
  color: #f97316;
  font-weight: 600;
}

/* 微信登录按钮 */
.btn-wechat-login {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: white;
  border: none;
  border-radius: 14rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.35);
  transition: all 0.2s;
}

.btn-wechat-login::after {
  border: none;
}

.btn-wechat-login:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(34, 197, 94, 0.25);
}

.wechat-icon {
  font-size: 40rpx;
}

/* 静默登录按钮 */
.btn-wechat-silent {
  background: transparent;
  color: #64748b;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.btn-wechat-silent::after {
  border: none;
}

/* 隐私政策勾选 */
.privacy-agreement {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 12rpx;
  margin: 32rpx 0;
  padding: 0 20rpx;
}

.privacy-checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  background: white;
  transition: all 0.2s;
}

.privacy-checkbox.checked {
  background: #f97316;
  border-color: #f97316;
  color: white;
}

.privacy-checkbox text {
  font-size: 22rpx;
  font-weight: bold;
}

.privacy-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  flex-wrap: wrap;
}

.privacy-link {
  color: #f97316;
  font-weight: 600;
}

.privacy-link:active {
  opacity: 0.7;
}

/* ========== 账号登录表单 - 优化样式 ========== */
.form-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
}

.form-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
  text-align: center;
  margin-bottom: 12rpx;
}

.form-subtitle {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 40rpx;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: white;
  border: none;
  border-radius: 14rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.35);
  transition: all 0.2s;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(249, 115, 22, 0.25);
}

.btn-primary[disabled] {
  opacity: 0.6;
  box-shadow: none;
}

/* 切换模式 */
.mode-switch {
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #64748b;
}

.mode-link {
  color: #f97316;
  font-weight: 600;
  margin-left: 8rpx;
}

.mode-link:active {
  opacity: 0.7;
}

.mode-row {
  display: block;
  margin-top: 12rpx;
}

.code-input {
  min-width: 0;
}

.code-btn {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #f97316;
  background: #fff7ed;
  border-radius: 12rpx;
  border: none;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.code-btn::after {
  border: none;
}

.code-btn.disabled {
  color: #94a3b8;
  background: #f1f5f9;
}

.input-group {
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 0 24rpx;
  height: 96rpx;
}

.input-group:focus-within {
  border-color: #fdba74;
  background: white;
  box-shadow: 0 0 0 4rpx rgba(249, 115, 22, 0.1);
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  height: 100%;
  border: none;
  background: transparent;
  font-size: 30rpx;
  color: #1e293b;
}

.input::placeholder {
  color: #94a3b8;
}

.eye-icon {
  padding: 16rpx;
  margin-right: -16rpx;
  opacity: 0.7;
  transition: opacity 0.2s;
}

.eye-icon:active {
  opacity: 1;
}

.input-label {
  display: block;
  font-size: 26rpx;
  color: #475569;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.login-input {
  width: 100%;
  height: 96rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  font-size: 30rpx;
  color: #1e293b;
  box-sizing: border-box;
  transition: all 0.2s;
}

.login-input:focus {
  border-color: #fdba74;
  background: white;
  box-shadow: 0 0 0 4rpx rgba(249, 115, 22, 0.1);
}

/* 主按钮 */
.btn-submit {
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: white;
  border: none;
  border-radius: 14rpx;
  padding: 28rpx 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.35);
  transition: all 0.2s;
}

.btn-submit::after {
  border: none;
}

.btn-submit:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(249, 115, 22, 0.25);
}

.btn-submit[disabled] {
  opacity: 0.6;
  box-shadow: none;
}

/* 切换模式文字 */
.switch-mode {
  text-align: center;
  margin-top: 32rpx;
  font-size: 28rpx;
  color: #64748b;
}

.switch-mode .link {
  color: #f97316;
  font-weight: 600;
  margin-left: 8rpx;
}

/* 错误提示 */
.error-box {
  background: linear-gradient(135deg, #fef2f2 0%, #fee2e2 100%);
  border: 2rpx solid #fecaca;
  color: #dc2626;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(220, 38, 38, 0.1);
}

.error-icon {
  font-size: 32rpx;
}

.error-text {
  flex: 1;
  font-weight: 500;
}

/* 密码显示/隐藏切换 */
.password-toggle {
  padding: 16rpx;
  font-size: 32rpx;
  opacity: 0.6;
  transition: opacity 0.2s;
}

.password-toggle:active {
  opacity: 1;
}

/* ========== 底部链接 - 优化样式 ========== */
.footer-links {
  display: flex;
  justify-content: center;
  gap: 48rpx;
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.5);
}

.footer-link {
  font-size: 26rpx;
  color: #64748b;
  font-weight: 500;
  transition: color 0.2s;
}

.footer-link:active {
  color: #f97316;
}

/* ========== 游客登录区域 ========== */
.guest-section {
  text-align: center;
  margin-top: 48rpx;
}

.guest-divider {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 32rpx;
  color: #94a3b8;
  font-size: 26rpx;
}

.guest-divider::before,
.guest-divider::after {
  content: '';
  flex: 1;
  height: 2rpx;
  background: rgba(148, 163, 184, 0.3);
}

.btn-guest {
  background: rgba(255, 255, 255, 0.8);
  color: #64748b;
  border: 2rpx solid #e2e8f0;
  border-radius: 14rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn-guest::after {
  border: none;
}
