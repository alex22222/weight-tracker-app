<!--pages/points/points.wxml-->
<view class="container">
  <!-- 积分卡片 -->
  <view class="points-card">
    <view class="points-header">
      <view class="points-title-row">
        <text class="points-label">我的积分</text>
        <view class="points-help" bindtap="showRules">
          <text class="help-icon">❓</text>
        </view>
      </view>
      <view class="points-value">
        <text class="points-number">{{summary.totalPoints}}</text>
        <text class="points-unit">分</text>
      </view>
    </view>
    
    <view class="points-stats">
      <view class="stat-item">
        <text class="stat-value">+{{summary.todayPoints}}</text>
        <text class="stat-label">今日</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">+{{summary.weekPoints}}</text>
        <text class="stat-label">本周</text>
      </view>
      <view class="stat-item">
        <text class="stat-value">+{{summary.monthPoints}}</text>
        <text class="stat-label">本月</text>
      </view>
    </view>
  </view>

  <!-- 积分排行 -->
  <view class="ranking-section">
    <view class="section-header" bindtap="toggleRanking">
      <text class="section-title">🏆 积分排行</text>
      <text class="toggle-btn">{{showRanking ? '收起 ▲' : '展开 ▼'}}</text>
    </view>
    <view class="ranking-list" wx:if="{{showRanking}}">
      <view class="ranking-item {{index < 3 ? 'top-' + (index + 1) : ''}}" wx:for="{{ranking}}" wx:key="userId">
        <view class="ranking-rank">
          <text wx:if="{{index < 3}}">{{['🥇','🥈','🥉'][index]}}</text>
          <text wx:else>{{index + 1}}</text>
        </view>
        <view class="ranking-user">
          <text class="ranking-name">{{item.username || '用户' + item.userId}}</text>
          <text class="ranking-streak" wx:if="{{item.streakDays > 0}}">🔥 {{item.streakDays}}天</text>
        </view>
        <view class="ranking-points">
          <text class="ranking-score">{{item.totalPoints}}</text>
          <text class="ranking-unit">分</text>
        </view>
      </view>
      <view class="ranking-empty" wx:if="{{ranking.length === 0}}">
        <text>暂无排行数据</text>
      </view>
    </view>
  </view>

  <!-- 连续打卡 -->
  <view class="streak-section">
    <view class="section-title">🔥 连续打卡</view>
    <view class="streak-cards">
      <view class="streak-card fitness">
        <view class="streak-icon">💪</view>
        <view class="streak-info">
          <text class="streak-name">健身打卡</text>
          <text class="streak-days">{{summary.currentStreak.fitness}} 天</text>
        </view>
      </view>
      <view class="streak-card reading">
        <view class="streak-icon">📚</view>
        <view class="streak-info">
          <text class="streak-name">读书打卡</text>
          <text class="streak-days">{{summary.currentStreak.reading}} 天</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 积分记录 -->
  <view class="logs-section">
    <view class="section-title">📋 积分记录</view>
    
    <view class="logs-list">
      <view class="log-item" wx:for="{{logs}}" wx:key="id">
        <view class="log-icon">{{item.type === 'login' ? '📅' : item.type === 'checkin_fitness' ? '💪' : item.type === 'checkin_reading' ? '📚' : item.type === 'continuous_3' ? '🔥' : item.type === 'continuous_7' ? '🌟' : item.type === 'continuous_30' ? '🏆' : '💎'}}</view>
        <view class="log-info">
          <text class="log-title">{{item.description}}</text>
          <text class="log-time">{{formatDate(item.createdAt)}}</text>
        </view>
        <view class="log-points">
          <text class="points-change">+{{item.points}}</text>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view class="loading-more" wx:if="{{isLoading}}">
      <text>加载中...</text>
    </view>
    <view class="no-more" wx:if="{{!hasMore && logs.length > 0}}">
      <text>没有更多记录了</text>
    </view>
    <view class="empty-logs" wx:if="{{!isLoading && logs.length === 0}}">
      <text>还没有积分记录，快去打卡吧！</text>
    </view>
  </view>

  <!-- 积分规则浮窗 -->
  <view class="rules-modal {{showRules ? 'show' : ''}}" catchtouchmove="preventTouchMove">
    <view class="rules-overlay" bindtap="hideRules"></view>
    <view class="rules-panel">
      <view class="rules-header">
        <text class="rules-title">📋 积分规则</text>
        <view class="rules-close" bindtap="hideRules">✕</view>
      </view>
      <view class="rules-content">
        <view class="rule-item">
          <text class="rule-icon">📅</text>
          <view class="rule-info">
            <text class="rule-name">每日登录</text>
            <text class="rule-points">+5 分</text>
          </view>
        </view>
        <view class="rule-item">
          <text class="rule-icon">💪</text>
          <view class="rule-info">
            <text class="rule-name">健身打卡</text>
            <text class="rule-points">+10 分</text>
          </view>
        </view>
        <view class="rule-item">
          <text class="rule-icon">📚</text>
          <view class="rule-info">
            <text class="rule-name">读书打卡</text>
            <text class="rule-points">+10 分</text>
          </view>
        </view>
        <view class="rule-item">
          <text class="rule-icon">🔥</text>
          <view class="rule-info">
            <text class="rule-name">连续3天打卡</text>
            <text class="rule-points">+5 分</text>
          </view>
        </view>
        <view class="rule-item">
          <text class="rule-icon">🌟</text>
          <view class="rule-info">
            <text class="rule-name">连续7天打卡</text>
            <text class="rule-points">+10 分</text>
          </view>
        </view>
        <view class="rule-item">
          <text class="rule-icon">🏆</text>
          <view class="rule-info">
            <text class="rule-name">连续30天打卡</text>
            <text class="rule-points">+30 分</text>
          </view>
        </view>
        <view class="rule-tip">
          <text>💡 提示：每天登录和打卡均可获得积分，连续打卡天数越多奖励越丰厚！</text>
        </view>
      </view>
    </view>
  </view>
</view>
