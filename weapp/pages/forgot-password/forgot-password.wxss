/* pages/forgot-password/forgot-password.wxss */

page {
  background: #f8fafc;
}

.container {
  padding: 40rpx;
  min-height: 100vh;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-card {
  width: 100%;
  background: white;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}

.form-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
  text-align: center;
  margin-bottom: 8rpx;
}

.form-subtitle {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
  margin-bottom: 48rpx;
}

.input-group {
  display: flex;
  align-items: center;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 0 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}

.input-group:focus-within {
  border-color: #f97316;
  background: white;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  height: 96rpx;
  font-size: 30rpx;
  color: #1e293b;
  background: transparent;
}

.code-input {
  min-width: 0;
}

.code-btn {
  padding: 12rpx 20rpx;
  font-size: 24rpx;
  color: #f97316;
  background: #fff7ed;
  border-radius: 12rpx;
  border: none;
  margin-left: 12rpx;
  flex-shrink: 0;
  line-height: 1.5;
}

.code-btn::after {
  border: none;
}

.code-btn.disabled {
  color: #94a3b8;
  background: #f1f5f9;
}

.password-toggle {
  padding: 20rpx;
  font-size: 32rpx;
  flex-shrink: 0;
}

.error-box {
  display: flex;
  align-items: center;
  background: #fef2f2;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.error-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.error-text {
  font-size: 26rpx;
  color: #ef4444;
  flex: 1;
}

.btn-primary {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 32rpx;
}

.btn-primary::after {
  border: none;
}

.mode-switch {
  text-align: center;
}

.mode-link {
  font-size: 28rpx;
  color: #f97316;
}
