<!--pages/forgot-password/forgot-password.wxml-->
<view class="container">
  <view class="form-card">
    <view class="form-title">🔐 找回密码</view>
    <view class="form-subtitle">通过邮箱验证重置密码</view>

    <!-- 邮箱 -->
    <view class="input-group">
      <view class="input-icon">📧</view>
      <input
        type="text"
        class="input"
        placeholder="注册邮箱"
        value="{{email}}"
        bindinput="onEmailInput"
      />
    </view>

    <!-- 验证码 -->
    <view class="input-group">
      <view class="input-icon">🔢</view>
      <input
        type="number"
        class="input code-input"
        placeholder="6位验证码"
        value="{{code}}"
        bindinput="onCodeInput"
      />
      <button 
        class="code-btn {{countdown > 0 ? 'disabled' : ''}}"
        bindtap="sendCode"
        disabled="{{countdown > 0 || sending}}"
      >
        {{countdown > 0 ? countdown + 's' : (sending ? '发送中...' : '获取验证码')}}
      </button>
    </view>

    <!-- 新密码 -->
    <view class="input-group">
      <view class="input-icon">🔒</view>
      <input
        type="{{showPassword ? 'text' : 'password'}}"
        class="input"
        placeholder="新密码（至少6位）"
        value="{{newPassword}}"
        bindinput="onPasswordInput"
      />
      <view class="password-toggle" bindtap="togglePasswordVisibility">
        <text>{{showPassword ? '🙈' : '👁️'}}</text>
      </view>
    </view>

    <!-- 错误提示 -->
    <view class="error-box" wx:if="{{error}}">
      <text class="error-icon">⚠️</text>
      <text class="error-text">{{error}}</text>
    </view>

    <!-- 提交按钮 -->
    <button class="btn-primary" bindtap="handleReset" disabled="{{isLoading}}">
      <text wx:if="{{isLoading}}">⏳ 处理中...</text>
      <text wx:else>重置密码</text>
    </button>

    <!-- 返回登录 -->
    <view class="mode-switch">
      <text class="mode-link" bindtap="goToLogin">← 返回登录</text>
    </view>
  </view>
</view>
