<!--pages/index/index.wxml-->
<view class="container">
  <view class="back-to-home" bindtap="goToHome">
    <text class="back-arrow">‹</text>
    <text class="back-text">返回首页</text>
  </view>
  <!-- 统计卡片区域 -->
  <view class="stats-grid">
    <!-- 当前体重 -->
    <view class="stat-card">
      <view class="stat-header">
        <view class="stat-icon bg-primary-light">
          <text class="icon">📊</text>
        </view>
        <text class="stat-label">当前体重</text>
      </view>
      <view class="stat-value-row">
        <text class="stat-value">{{currentWeightText}}</text>
        <text class="stat-unit">kg</text>
      </view>
      <text class="stat-hint {{weightDiffClass}}" wx:if="{{currentWeight > 0}}">
        {{weightDiffText}}目标 {{weightDiffValue}} kg
      </text>
    </view>

    <!-- BMI -->
    <view class="stat-card {{bmiStyle.bg}}" style="border: {{bmiStyle.border}};">
      <view class="stat-header">
        <view class="stat-icon {{bmiStyle.bg}}">
          <text class="icon">🎯</text>
        </view>
        <text class="stat-label">BMI 指数</text>
      </view>
      <view class="stat-value-row">
        <text class="stat-value" style="color: {{bmiStyle.color}};">{{bmi > 0 ? bmi : '--'}}</text>
      </view>
      <text class="stat-hint" style="color: {{bmiStyle.color}};">{{bmiCategory.label}}</text>
    </view>

    <!-- 目标体重 -->
    <view class="stat-card" bindtap="openSettings" style="cursor: pointer;">
      <view class="stat-header">
        <view class="stat-icon bg-primary-light">
          <text class="icon">⚖️</text>
        </view>
        <text class="stat-label">目标体重</text>
      </view>
      <view class="stat-value-row">
        <text class="stat-value">{{settings.targetWeight}}</text>
        <text class="stat-unit">kg</text>
      </view>
      <text class="stat-hint text-tertiary">点击修改 · 身高 {{settings.height}} cm</text>
    </view>
  </view>

  <!-- 上次记录 -->
  <view class="last-record-card" wx:if="{{lastRecord}}">
    <view class="last-record-header">
      <text class="last-record-icon">🕐</text>
      <text class="last-record-title">上次记录</text>
    </view>
    <view class="last-record-content">
      <text class="last-record-weight">{{lastRecord.weight}} kg</text>
      <text class="last-record-date">{{lastRecord.formattedDate}}</text>
      <text class="last-record-days" wx:if="{{lastRecord.daysAgo > 0}}">{{lastRecord.daysAgo}} 天前</text>
      <text class="last-record-days today" wx:else>今天</text>
    </view>
  </view>

  <!-- 添加记录表单 -->
  <view class="card">
    <view class="section-title">
      <text class="title-icon">➕</text>
      <text>记录体重</text>
    </view>
    
    <view class="form-grid">
      <view class="form-item">
        <text class="form-label">日期</text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="input picker-input">{{date}}</view>
        </picker>
      </view>
      
      <view class="form-item">
        <text class="form-label">体重 (kg)</text>
        <input 
          type="digit" 
          class="input" 
          placeholder="例如: 70.5" 
          value="{{weight}}"
          bindinput="onWeightInput"
        />
      </view>
      
      <view class="form-item form-item-full">
        <text class="form-label">备注 (可选)</text>
        <input 
          type="text" 
          class="input" 
          placeholder="例如: 早餐后" 
          value="{{note}}"
          bindinput="onNoteInput"
        />
      </view>

    </view>
    
    <button class="btn-primary mt-3" bindtap="addEntry" disabled="{{!weight || isLoading}}">
      <text wx:if="{{isLoading}}">⏳ 保存中...</text>
      <text wx:else>➕ 添加记录</text>
    </button>
  </view>

  <!-- 体重趋势图表 -->
  <view class="card" wx:if="{{chartData.length > 0}}">
    <view class="section-title">
      <text class="title-icon">📈</text>
      <text>体重趋势</text>
    </view>
    <view class="chart-view-tabs">
      <view class="chart-view-tab {{chartViewMode === 'day' ? 'active' : ''}}" bindtap="switchChartView" data-mode="day">日</view>
      <view class="chart-view-tab {{chartViewMode === 'week' ? 'active' : ''}}" bindtap="switchChartView" data-mode="week">周</view>
      <view class="chart-view-tab {{chartViewMode === 'month' ? 'active' : ''}}" bindtap="switchChartView" data-mode="month">月</view>
    </view>
    <view class="chart-container">
      <canvas type="2d" id="weightChart" class="chart-canvas" bindtouchstart="onChartTouch"></canvas>
    </view>
  </view>

  <!-- 历史记录列表 -->
  <view class="card" wx:if="{{entries.length > 0}}">
    <view class="section-title">
      <text class="title-icon">📋</text>
      <text>历史记录</text>
    </view>
    <view class="history-list">
      <view class="history-item" wx:for="{{entries}}" wx:key="id">
        <view class="history-main">
          <view class="history-info">
            <text class="history-weight">{{item.weight}} kg</text>
            <text class="history-date">{{item.displayDate}}</text>
          </view>
          <text class="history-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
      </view>
    </view>
  </view>

</view>
