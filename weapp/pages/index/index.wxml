<!--pages/index/index.wxml-->
<view class="container">
  <!-- 顶部导航 -->
  <view class="header">
    <view class="header-left">
      <view class="header-avatar" bindtap="chooseAvatar">
        <image wx:if="{{userInfo.avatar}}" class="avatar-img" src="{{userInfo.avatar}}" mode="aspectFill" />
        <text wx:else class="avatar-text">{{avatarText}}</text>
      </view>
      <view class="header-title">
        <text class="title-main">欢迎「{{welcomeName}}」</text>
        <view class="channel-info" bindtap="goToChannel" wx:if="{{activeChannel}}">
          <text>参与活动：{{activeChannel.name}} ({{activeChannelStatusText}})</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 统计卡片区域 -->
  <view class="stats-grid">
    <!-- 当前体重 -->
    <view class="stat-card">
      <view class="stat-header">
        <view class="stat-icon bg-primary-light">
          <text class="icon">📊</text>
        </view>
        <text class="stat-label">当前体重</text>
      </view>
      <view class="stat-value-row">
        <text class="stat-value">{{currentWeightText}}</text>
        <text class="stat-unit">kg</text>
      </view>
      <text class="stat-hint {{weightDiffClass}}" wx:if="{{currentWeight > 0}}">
        {{weightDiffText}}目标 {{weightDiffValue}} kg
      </text>
    </view>

    <!-- BMI -->
    <view class="stat-card {{bmiStyle.bg}}" style="border: {{bmiStyle.border}};">
      <view class="stat-header">
        <view class="stat-icon {{bmiStyle.bg}}">
          <text class="icon">🎯</text>
        </view>
        <text class="stat-label">BMI 指数</text>
      </view>
      <view class="stat-value-row">
        <text class="stat-value" style="color: {{bmiStyle.color}};">{{bmi > 0 ? bmi : '--'}}</text>
      </view>
      <text class="stat-hint" style="color: {{bmiStyle.color}};">{{bmiCategory.label}}</text>
    </view>

    <!-- 目标体重 -->
    <view class="stat-card" bindtap="openSettings" style="cursor: pointer;">
      <view class="stat-header">
        <view class="stat-icon bg-primary-light">
          <text class="icon">⚖️</text>
        </view>
        <text class="stat-label">目标体重</text>
      </view>
      <view class="stat-value-row">
        <text class="stat-value">{{settings.targetWeight}}</text>
        <text class="stat-unit">kg</text>
      </view>
      <text class="stat-hint text-tertiary">点击修改 · 身高 {{settings.height}} cm</text>
    </view>
  </view>

  <!-- 添加记录表单 -->
  <view class="card">
    <view class="section-title">
      <text class="title-icon">➕</text>
      <text>记录体重</text>
    </view>
    
    <view class="form-grid">
      <view class="form-item">
        <text class="form-label">日期</text>
        <picker mode="date" value="{{date}}" bindchange="onDateChange">
          <view class="input picker-input">{{date}}</view>
        </picker>
      </view>
      
      <view class="form-item">
        <text class="form-label">体重 (kg)</text>
        <input 
          type="digit" 
          class="input" 
          placeholder="例如: 70.5" 
          value="{{weight}}"
          bindinput="onWeightInput"
        />
      </view>
      
      <view class="form-item form-item-full">
        <text class="form-label">备注 (可选)</text>
        <input 
          type="text" 
          class="input" 
          placeholder="例如: 早餐后" 
          value="{{note}}"
          bindinput="onNoteInput"
        />
      </view>
    </view>
    
    <button class="btn-primary mt-3" bindtap="addEntry" disabled="{{!weight || isLoading}}">
      <text wx:if="{{isLoading}}">⏳ 保存中...</text>
      <text wx:else>➕ 添加记录</text>
    </button>
  </view>

  <!-- 体重趋势图表 -->
  <view class="card" wx:if="{{chartData.length > 0}}">
    <view class="section-title">
      <text class="title-icon">📈</text>
      <text>体重趋势 (近7次)</text>
    </view>
    <view class="chart-container">
      <canvas type="2d" id="weightChart" class="chart-canvas" bindtouchstart="onChartTouch"></canvas>
    </view>
  </view>

  <!-- 分享按钮 -->
  <view class="card share-card" wx:if="{{!showSettings}}">
    <view class="share-content">
      <view class="share-text">
        <text class="share-title">邀请好友一起健身</text>
        <text class="share-desc">分享给你的微信好友，一起记录体重变化</text>
      </view>
      <button class="btn-share" open-type="share">
        <text>📤 分享给好友</text>
      </button>
    </view>
  </view>
</view>
