/* pages/index/index.wxss */

page {
  background: #f8fafc;
}

.container {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* 上次记录卡片 */
.last-record-card {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.25);
}

.last-record-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.last-record-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.last-record-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.last-record-content {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.last-record-weight {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
}

.last-record-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.last-record-days {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.last-record-days.today {
  background: rgba(34, 197, 94, 0.3);
  color: #86efac;
}

/* 历史记录列表 */
.history-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.history-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.history-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-weight {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.history-date {
  font-size: 24rpx;
  color: #94a3b8;
}

.history-note {
  font-size: 26rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 12rpx 16rpx;
  border-radius: 8rpx;
}

.history-image {
  width: 100%;
  height: 320rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f1f5f9;
}

.history-img {
  width: 100%;
  height: 100%;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.header-left {
  display: flex;
  align-items: center;
  flex: 1;
}

.header-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-right: 20rpx;
  flex-shrink: 0;
  background: linear-gradient(135deg, #f97316, #ea580c);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.avatar-text {
  font-size: 36rpx;
  color: white;
  font-weight: 600;
}

.header-title {
  flex: 1;
  min-width: 0;
}

.title-main {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
}

.channel-info {
  font-size: 24rpx;
  color: #f97316;
  margin-top: 8rpx;
}

.header-btn {
  width: 64rpx;
  height: 64rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

/* 统计卡片 */
.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.stat-card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat-header {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.stat-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
}

.bg-primary-light {
  background: #fff7ed;
}

.stat-label {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.stat-value-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  margin-bottom: 8rpx;
}

.stat-value {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
}

.stat-unit {
  font-size: 24rpx;
  color: #94a3b8;
}

.stat-hint {
  font-size: 22rpx;
  font-weight: 500;
}

.text-success {
  color: #f97316;
}

.text-danger {
  color: #ef4444;
}

.text-tertiary {
  color: #94a3b8;
}

/* 卡片 */
.card {
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 20rpx;
}

.title-icon {
  font-size: 32rpx;
}

/* 表单 */
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.form-item {
  display: flex;
  flex-direction: column;
}

.form-item-full {
  grid-column: span 2;
}

.form-label {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.input {
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #1e293b;
}

.picker-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-input::after {
  content: '▼';
  font-size: 20rpx;
  color: #94a3b8;
}

/* 按钮 */
.btn-primary {
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: white;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(249, 115, 22, 0.4);
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(249, 115, 22, 0.3);
}

.btn-primary[disabled] {
  opacity: 0.5;
}

.btn-secondary {
  background: #f1f5f9;
  color: #475569;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
}

.mt-3 {
  margin-top: 24rpx;
}

.flex {
  display: flex;
}

.gap-2 {
  gap: 16rpx;
}

.flex-1 {
  flex: 1;
}

/* 图表 */
.chart-container {
  width: 100%;
  height: 400rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  overflow: hidden;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* 分享卡片 */
.share-card {
  background: linear-gradient(135deg, #fff7ed, #ffedd5);
  border: 2rpx solid #fed7aa;
}

.share-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.share-text {
  margin-bottom: 20rpx;
}

.share-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.share-desc {
  display: block;
  font-size: 24rpx;
  color: #64748b;
}

.btn-share {
  background: linear-gradient(135deg, #f97316, #ea580c);
  color: white;
  border: none;
  border-radius: 30rpx;
  padding: 20rpx 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(249, 115, 22, 0.35);
}

.btn-share::after {
  border: none;
}

.btn-share:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(249, 115, 22, 0.25);
}

.btn-share::after {
  border: none;
}

/* 图片上传 */
.photo-uploader {
  display: flex;
  gap: 20rpx;
}

.photo-add {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
}

.photo-add-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.photo-add-text {
  font-size: 24rpx;
  color: #94a3b8;
}

.photo-preview {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0,0,0,0.5);
  color: white;
  font-size: 24rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
