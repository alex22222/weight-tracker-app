@import "../../app.wxss";

.page-header {
  padding: 30rpx 0;
  text-align: center;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
}

.page-subtitle {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 8rpx;
  display: block;
}

.stats-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  flex: 1;
  border-radius: 20rpx;
  padding: 30rpx;
  text-align: center;
  color: white;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}

.card {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.title-icon {
  font-size: 32rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.form-item {
  flex: 1;
}

.form-label {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 10rpx;
  display: block;
}

.form-input, .form-picker {
  height: 80rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1e293b;
  line-height: 80rpx;
}

.btn-primary {
  width: 100%;
  height: 90rpx;
  color: white;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary.disabled {
  opacity: 0.6;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.record-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
  position: relative;
}

.record-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.record-date {
  font-size: 24rpx;
  color: #94a3b8;
}

.record-note {
  font-size: 26rpx;
  color: #64748b;
}

.record-note.empty {
  color: #cbd5e1;
}

.record-delete {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  padding: 10rpx;
}

.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #64748b;
  display: block;
}

.empty-sub {
  font-size: 26rpx;
  color: #94a3b8;
  margin-top: 10rpx;
  display: block;
}
