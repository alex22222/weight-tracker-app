.container {
  padding: 24rpx;
  background: #f8fafc;
  min-height: 100vh;
}

/* 上传区域 */
.upload-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.upload-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  text-align: center;
  margin-bottom: 8rpx;
}

.upload-subtitle {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 32rpx;
}

.upload-box {
  border: 2rpx dashed #cbd5e1;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.upload-icon {
  font-size: 72rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #94a3b8;
}

.preview-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.preview-img {
  width: 400rpx;
  height: 400rpx;
  border-radius: 20rpx;
  object-fit: cover;
}

.preview-actions {
  display: flex;
  gap: 24rpx;
}

.action-btn {
  padding: 16rpx 40rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #64748b;
  background: #f1f5f9;
}

.action-btn.primary {
  background: #f97316;
  color: #fff;
  font-weight: 600;
}

.quota-tip {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
}

.quota-num {
  color: #f97316;
  font-weight: 700;
  font-size: 32rpx;
}

/* 分析中 */
.analyzing-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #e2e8f0;
  border-top-color: #f97316;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.analyzing-text {
  font-size: 28rpx;
  color: #64748b;
}

/* 结果区域 */
.result-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 24rpx;
}

.calorie-badge {
  display: flex;
  align-items: baseline;
  justify-content: center;
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.calorie-num {
  font-size: 80rpx;
  font-weight: 800;
  color: #f97316;
}

.calorie-unit {
  font-size: 32rpx;
  color: #64748b;
}

.food-list {
  margin-bottom: 24rpx;
}

.food-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.food-dot {
  color: #f97316;
  font-size: 32rpx;
}

.food-name {
  font-size: 28rpx;
  color: #334155;
}

.analysis-text {
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.6;
  background: #f8fafc;
  padding: 20rpx;
  border-radius: 12rpx;
}

/* 失败提示 */
.fail-box {
  background: #fff;
  border-radius: 24rpx;
  padding: 60rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.fail-icon {
  font-size: 60rpx;
}

.fail-text {
  font-size: 28rpx;
  color: #64748b;
}

/* 历史记录 */
.history-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.history-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.history-count {
  font-size: 24rpx;
  color: #94a3b8;
}

.history-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.history-item {
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 24rpx;
}

.history-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.history-calories {
  font-size: 32rpx;
  font-weight: 700;
  color: #f97316;
}

.history-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.history-foods {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.history-food {
  font-size: 22rpx;
  color: #64748b;
  background: #e2e8f0;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.history-actions {
  display: flex;
  justify-content: flex-end;
}

.delete-btn {
  font-size: 24rpx;
  color: #ef4444;
  padding: 8rpx 16rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #334155;
  font-weight: 600;
}

.empty-sub {
  font-size: 26rpx;
  color: #94a3b8;
}

