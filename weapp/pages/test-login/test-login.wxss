.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.header {
  font-size: 40rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #333;
}

.section {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}

.label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.api-url {
  font-size: 24rpx;
  color: #999;
  word-break: break-all;
}

.input {
  border: 1rpx solid #ddd;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
  font-size: 30rpx;
}

.button-group {
  display: flex;
  gap: 15rpx;
  margin-bottom: 20rpx;
}

.btn {
  flex: 1;
  font-size: 28rpx;
  padding: 20rpx 0;
  background: #e0e0e0;
  border: none;
  border-radius: 8rpx;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}

.btn-danger {
  background: #ff4d4f;
  color: #fff;
}

.results {
  background: #fff;
  padding: 20rpx;
  border-radius: 12rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  color: #333;
}

.empty {
  color: #999;
  text-align: center;
  padding: 40rpx 0;
}

.result-item {
  padding: 20rpx;
  border-radius: 8rpx;
  margin-bottom: 15rpx;
  font-size: 26rpx;
}

.result-info {
  background: #e6f7ff;
  border-left: 6rpx solid #1890ff;
}

.result-success {
  background: #f6ffed;
  border-left: 6rpx solid #52c41a;
}

.result-error {
  background: #fff2f0;
  border-left: 6rpx solid #ff4d4f;
}

.result-warning {
  background: #fffbe6;
  border-left: 6rpx solid #faad14;
}

.result-time {
  font-size: 22rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.result-message {
  font-weight: bold;
  margin-bottom: 8rpx;
}

.result-detail {
  font-size: 24rpx;
  color: #666;
  word-break: break-all;
  white-space: pre-wrap;
}
