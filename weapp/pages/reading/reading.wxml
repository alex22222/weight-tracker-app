<!--pages/reading/reading.wxml-->
<view class="container">
  <view class="back-to-home" bindtap="goToHome">
    <text class="back-arrow">‹</text>
    <text class="back-text">返回首页</text>
  </view>
  <!-- 头部 -->
  <view class="header">
    <view class="header-icon">📖</view>
    <view class="header-title">
      <text class="title-main">读书记录</text>
      <text class="title-sub">记录你的阅读时光</text>
    </view>
  </view>

  <!-- 书籍推荐轮播 -->
  <view class="recommend-section" wx:if="{{recommendBooks.length > 0}}">
    <view class="recommend-header">
      <text class="recommend-title">📚 每日推荐</text>
    </view>
    <swiper class="recommend-swiper" indicator-dots="true" autoplay="true" interval="5000" duration="500" circular="true">
      <swiper-item wx:for="{{recommendBooks}}" wx:key="id">
        <view class="recommend-card">
          <image class="recommend-cover" src="{{item.coverUrl || '/assets/book-default.png'}}" mode="aspectFill" />
          <view class="recommend-info">
            <text class="recommend-book-name">《{{item.title}}》</text>
            <text class="recommend-author">{{item.author}}</text>
            <text class="recommend-desc">{{item.description}}</text>
            <view class="recommend-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 上次记录 -->
  <view class="last-record-card" wx:if="{{lastRecord}}">
    <view class="last-record-header">
      <text class="last-record-icon">🕐</text>
      <text class="last-record-title">上次记录</text>
    </view>
    <view class="last-record-content">
      <text class="last-record-book">《{{lastRecord.bookName}}》</text>
      <text class="last-record-pages">{{lastRecord.pages}} 页</text>
    </view>
    <view class="last-record-footer">
      <text class="last-record-date">{{lastRecord.formattedDate}}</text>
      <text class="last-record-days" wx:if="{{lastRecord.daysAgo > 0}}">{{lastRecord.daysAgo}} 天前</text>
      <text class="last-record-days today" wx:else>今天</text>
    </view>
  </view>

  <!-- 连续记录卡片 -->
  <view class="streak-card">
    <view class="streak-content">
      <text class="streak-label">当前连续记录</text>
      <text class="streak-value">{{streakDays}} 天</text>
    </view>
    <view class="streak-icon">🏅</view>
  </view>

  <!-- 今日记录 -->
  <view class="section-card">
    <view class="section-title">今日记录</view>
    
    <!-- 书名 -->
    <view class="form-item">
      <text class="form-label">书名</text>
      <view class="input-wrap">
        <text class="input-icon">📖</text>
        <input 
          type="text" 
          class="input" 
          placeholder="例如：《活着》"
          value="{{bookName}}"
          bindinput="onBookNameInput"
        />
      </view>
    </view>

    <!-- 阅读页数 -->
    <view class="form-item">
      <text class="form-label">阅读页数</text>
      <view class="input-wrap">
        <text class="input-icon">📄</text>
        <input 
          type="number" 
          class="input" 
          placeholder="30"
          value="{{pages}}"
          bindinput="onPagesInput"
        />
      </view>
    </view>

    <!-- 读书笔记 -->
    <view class="form-item">
      <text class="form-label">读书笔记（可选）</text>
      <textarea 
        class="textarea" 
        placeholder="记录你的感悟或摘抄..."
        value="{{note}}"
        bindinput="onNoteInput"
        maxlength="500"
      />
    </view>

    <!-- 记录按钮 -->
    <button 
      class="btn-checkin {{hasCheckedInToday ? 'checked' : ''}}" 
      bindtap="submitCheckIn" 
      disabled="{{isSubmitting || hasCheckedInToday}}"
    >
      <text wx:if="{{isSubmitting}}">提交中...</text>
      <text wx:elif="{{hasCheckedInToday}}">✅ 今日已记录</text>
      <text wx:else>完成记录</text>
    </button>
    <text class="checkin-hint" wx:if="{{hasCheckedInToday}}">明天继续加油！💪</text>
  </view>

  <!-- 最近阅读记录 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-icon">📋</text>
      <text class="section-title">最近阅读记录</text>
    </view>
    
    <!-- 记录列表 -->
    <view class="record-list" wx:if="{{records.length > 0}}">
      <view class="record-item" wx:for="{{records}}" wx:key="id">
        <view class="record-info">
          <text class="record-book">{{item.bookName}}</text>
          <text class="record-meta">{{item.date}} · {{item.pages}}页</text>
          <text class="record-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
      </view>
    </view>
    
    <!-- 空状态 -->
    <view class="empty-state" wx:else>
      <text class="empty-text">暂无阅读记录</text>
    </view>
  </view>
</view>
