/* pages/reading/reading.wxss */

.container {
  padding: 20rpx;
  background: #f8fafc;
  min-height: 100vh;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 0 30rpx;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.header-title {
  flex: 1;
}

.title-main {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
}

.title-sub {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

/* 连续打卡卡片 */
.streak-card {
  background: linear-gradient(135deg, #7c3aed, #db2777);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.streak-content {
  flex: 1;
}

.streak-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 12rpx;
}

.streak-value {
  font-size: 56rpx;
  font-weight: 700;
  color: white;
  display: block;
}

.streak-icon {
  font-size: 80rpx;
  opacity: 0.3;
}

/* 卡片通用样式 */
.section-card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 表单样式 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 16rpx;
  display: block;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #94a3b8;
}

.input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #1e293b;
  background: transparent;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
}

/* 打卡按钮 */
.btn-checkin {
  width: 100%;
  height: 88rpx;
  background: #0f172a;
  color: white;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
}

.btn-checkin[disabled] {
  opacity: 0.5;
}

.btn-checkin::after {
  border: none;
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.record-book {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
}

.record-meta {
  font-size: 24rpx;
  color: #64748b;
  display: block;
  margin-bottom: 12rpx;
}

.record-note {
  font-size: 26rpx;
  color: #475569;
  display: block;
  padding-top: 12rpx;
  border-top: 2rpx solid #e2e8f0;
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}
