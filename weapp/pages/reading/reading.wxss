/* pages/reading/reading.wxss */

.container {
  padding: 20rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  background: #f8fafc;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 上次打卡卡片 */
.last-record-card {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.25);
}

.last-record-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.last-record-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.last-record-title {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
}

.last-record-content {
  margin-bottom: 12rpx;
}

.last-record-book {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 8rpx;
}

.last-record-pages {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
}

.last-record-footer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid rgba(255, 255, 255, 0.15);
}

.last-record-date {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.last-record-days {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  background: rgba(255, 255, 255, 0.15);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.last-record-days.today {
  background: rgba(34, 197, 94, 0.3);
  color: #86efac;
}

/* 头部 */
.header {
  display: flex;
  align-items: center;
  padding: 20rpx 0 30rpx;
}

.header-icon {
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.header-title {
  flex: 1;
}

.title-main {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
}

.title-sub {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

/* 连续打卡卡片 */
.streak-card {
  background: linear-gradient(135deg, #f97316, #ea580c);
  border-radius: 24rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.3);
}

.streak-content {
  flex: 1;
}

.streak-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
  display: block;
  margin-bottom: 12rpx;
}

.streak-value {
  font-size: 56rpx;
  font-weight: 700;
  color: white;
  display: block;
}

.streak-icon {
  font-size: 80rpx;
  opacity: 0.3;
}

/* 卡片通用样式 */
.section-card {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

/* 表单样式 */
.form-item {
  margin-bottom: 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 16rpx;
  display: block;
}

.input-wrap {
  display: flex;
  align-items: center;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.input-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  color: #94a3b8;
}

.input {
  flex: 1;
  height: 88rpx;
  font-size: 28rpx;
  color: #1e293b;
  background: transparent;
}

.textarea {
  width: 100%;
  height: 160rpx;
  background: #f1f5f9;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
}

/* 打卡按钮 */
.btn-checkin {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.35);
  transition: all 0.2s;
}

.btn-checkin:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(249, 115, 22, 0.25);
}

.btn-checkin.checked {
  background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%);
  box-shadow: 0 4rpx 16rpx rgba(34, 197, 94, 0.35);
}

.btn-checkin[disabled] {
  opacity: 0.7;
  transform: none !important;
}

.btn-checkin::after {
  border: none;
}

.checkin-hint {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #22c55e;
  margin-top: 16rpx;
}

/* 记录列表 */
.record-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.record-book {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
}

.record-meta {
  font-size: 24rpx;
  color: #64748b;
  display: block;
  margin-bottom: 12rpx;
}

.record-note {
  font-size: 26rpx;
  color: #475569;
  display: block;
  padding-top: 12rpx;
  border-top: 2rpx solid #e2e8f0;
}

/* 空状态 */
.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}

/* 书籍推荐轮播 */
.recommend-section {
  margin-bottom: 24rpx;
}

.recommend-header {
  margin-bottom: 16rpx;
}

.recommend-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.recommend-swiper {
  height: 280rpx;
}

.recommend-card {
  display: flex;
  background: white;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 0 10rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.08);
  height: 100%;
  box-sizing: border-box;
}

.recommend-cover {
  width: 160rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.recommend-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.recommend-book-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 8rpx;
}

.recommend-author {
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.recommend-desc {
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.recommend-tag {
  display: inline-block;
  font-size: 22rpx;
  color: #8b5cf6;
  background: #f3e8ff;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  align-self: flex-start;
}
