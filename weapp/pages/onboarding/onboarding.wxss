/* pages/onboarding/onboarding.wxss */

page {
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 50%, #fed7aa 100%);
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: 40rpx;
  box-sizing: border-box;
}

/* ========== 进度指示器 - 优化样式 ========== */
.progress-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 48rpx;
  padding-top: 20rpx;
}

.progress-dots {
  display: flex;
  gap: 12rpx;
}

.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.5);
  transition: all 0.3s;
}

.dot.active {
  background: #f97316;
  width: 40rpx;
  border-radius: 7rpx;
}

.dot.completed {
  background: rgba(249, 115, 22, 0.6);
}

.progress-text {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
  font-weight: 600;
}

/* ========== 步骤内容 ========== */
.step-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.step {
  animation: fadeIn 0.4s ease;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* ========== 欢迎页 - 优化视觉 ========== */
.welcome-step {
  text-align: center;
  color: #1e293b;
}

.welcome-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  display: inline-block;
  animation: bounce 2s ease infinite;
}

@keyframes bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-15rpx); }
}

.welcome-title {
  font-size: 52rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  letter-spacing: -1rpx;
}

.welcome-subtitle {
  font-size: 32rpx;
  color: #475569;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.welcome-desc {
  font-size: 26rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.6);
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  display: inline-block;
}

/* ========== 步骤标题 - 统一样式 ========== */
.step-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #1e293b;
  text-align: center;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.step-subtitle {
  font-size: 28rpx;
  color: #64748b;
  text-align: center;
  margin-bottom: 48rpx;
  font-weight: 500;
}

/* ========== 头像选择 - 优化网格 ========== */
.avatar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 32rpx;
}

.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 24rpx 12rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 20rpx;
  border: 3rpx solid transparent;
  transition: all 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.avatar-item.selected {
  background: white;
  border-color: #f97316;
  transform: scale(1.05);
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.25);
}

.avatar-emoji {
  font-size: 56rpx;
  line-height: 1;
}

.avatar-name {
  font-size: 24rpx;
  color: #64748b;
  font-weight: 500;
}

.avatar-divider {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.5);
  margin: 32rpx 20rpx;
}

.avatar-upload-option {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx;
  margin: 0 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 16rpx;
  border: 2rpx dashed #cbd5e1;
  transition: all 0.2s;
}

.avatar-upload-option:active {
  background: rgba(255, 255, 255, 0.9);
  border-color: #f97316;
}

.upload-icon {
  font-size: 40rpx;
}

.upload-text {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
}

.avatar-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-top: 32rpx;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.preview-label {
  font-size: 28rpx;
  color: #64748b;
}

.preview-emoji {
  font-size: 56rpx;
  line-height: 1;
}

/* ========== 性别选择 - 优化卡片 ========== */
.gender-options {
  display: flex;
  gap: 32rpx;
  justify-content: center;
}

.gender-card {
  width: 280rpx;
  height: 340rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  border: 3rpx solid transparent;
  transition: all 0.25s;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.gender-card.selected {
  background: white;
  border-color: #f97316;
  transform: scale(1.03);
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.2);
}

.gender-icon {
  font-size: 88rpx;
}

.gender-text {
  font-size: 32rpx;
  color: #475569;
  font-weight: 600;
}

/* ========== 输入框 - 统一样式 ========== */
.input-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.large-input {
  width: 320rpx;
  height: 120rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  text-align: center;
  font-size: 64rpx;
  font-weight: 700;
  color: #1e293b;
  caret-color: #f97316;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.large-input:focus {
  border-color: #fdba74;
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.15);
}

.large-input::placeholder {
  color: #cbd5e1;
}

.input-unit {
  font-size: 36rpx;
  color: #64748b;
  font-weight: 600;
}

.input-hint {
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
  font-weight: 500;
}

/* ========== 底部按钮 - 统一样式 ========== */
.footer {
  padding: 32rpx 0 48rpx;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  color: white;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(249, 115, 22, 0.35);
  transition: all 0.2s;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 12rpx rgba(249, 115, 22, 0.25);
}

.btn-secondary {
  width: 100%;
  height: 100rpx;
  background: rgba(255, 255, 255, 0.8);
  color: #64748b;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border: 2rpx solid #e2e8f0;
}

.btn-secondary::after {
  border: none;
}

.btn-text {
  background: transparent;
  color: #64748b;
  font-size: 28rpx;
  border: none;
  padding: 16rpx 40rpx;
  font-weight: 500;
}

.btn-text::after {
  border: none;
}

.btn-row {
  display: flex;
  justify-content: center;
  gap: 48rpx;
}
