page {
  background: #f8fafc;
}

.container {
  padding: 32rpx;
  padding-bottom: 64rpx;
}

.header {
  text-align: center;
  margin-bottom: 48rpx;
  padding-top: 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 24rpx;
  color: #94a3b8;
}

.section {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 16rpx;
}

.section-content {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.7;
}

.section-list {
  margin-top: 16rpx;
}

.list-item {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.7;
  margin-bottom: 8rpx;
}

.footer {
  text-align: center;
  margin-top: 48rpx;
  font-size: 24rpx;
  color: #94a3b8;
}
