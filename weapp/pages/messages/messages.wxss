/* pages/messages/messages.wxss */

page {
  background: #f8fafc;
}

.container {
  padding: 24rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  min-height: 100vh;
  box-sizing: border-box;
}

/* 头部 */
.header-section {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: linear-gradient(135deg, #f97316, #ea580c);
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.25);
}

.header-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}

.header-content {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
}

.header-subtitle {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 8rpx;
}

/* 操作栏 */
.action-bar {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 20rpx;
}

.action-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #64748b;
  background: white;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.action-btn.clear-all {
  color: #ef4444;
  background: #fef2f2;
}

.action-btn.batch-mode {
  color: #f97316;
  background: #fff7ed;
}

.action-btn.select-all {
  color: #3b82f6;
  background: #eff6ff;
}

.action-btn.batch-delete {
  color: #ef4444;
  background: #fef2f2;
}

.action-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

/* 消息列表 */
.message-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.message-item {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  display: flex;
  align-items: flex-start;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  border: 2rpx solid transparent;
}

.message-item.unread {
  border-color: #dbeafe;
  background: #eff6ff;
}

.message-icon {
  width: 72rpx;
  height: 72rpx;
  background: #f1f5f9;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.message-content {
  flex: 1;
  min-width: 0;
}

.message-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.message-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  flex: 1;
}

.message-type-tag {
  font-size: 20rpx;
  color: #f97316;
  background: #fff7ed;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-left: 12rpx;
}

.message-text {
  display: block;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 12rpx;
}

.message-time {
  font-size: 22rpx;
  color: #94a3b8;
}

.message-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  margin-left: 16rpx;
}

.message-checkbox {
  margin-right: 16rpx;
  flex-shrink: 0;
}

.checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #cbd5e1;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: white;
}

.checkbox.checked {
  background: #f97316;
  border-color: #f97316;
  color: white;
}

.checkbox text {
  font-size: 24rpx;
  font-weight: bold;
}

.unread-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ef4444;
  border-radius: 50%;
}

.delete-btn {
  font-size: 32rpx;
  padding: 10rpx;
  opacity: 0.6;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}

.empty-subtext {
  font-size: 26rpx;
  color: #94a3b8;
}
