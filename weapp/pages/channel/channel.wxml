<!--pages/channel/channel.wxml-->
<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="header-title">一起打卡</text>
    <view class="header-action" bindtap="showCreateModal">
      <text class="action-icon">+</text>
      <text>发起任务</text>
    </view>
  </view>

  <!-- 任务列表 -->
  <view class="task-list" wx:if="{{tasks.length > 0}}">
    <view class="task-card {{task.status}}" wx:for="{{tasks}}" wx:key="id">
      <!-- 任务头部 -->
      <view class="task-header" bindtap="goToDetail" data-id="{{item.id}}">
        <view class="task-type-icon">{{item.type === 'fitness' ? '💪' : '📖'}}</view>
        <view class="task-info">
          <text class="task-title">{{item.title}}</text>
          <text class="task-desc" wx:if="{{item.description}}">{{item.description}}</text>
          <view class="task-meta">
            <text class="task-date">{{item.dateRange}}</text>
            <text class="task-members">{{item.memberCount}}人参与</text>
          </view>
        </view>
        <view class="task-status-badge {{item.status}}">
          {{item.status === 'pending' ? '待开始' : item.status === 'active' ? '进行中' : item.status === 'completed' ? '已结束' : '已取消'}}
        </view>
      </view>

      <!-- 操作按钮 -->
      <view class="task-actions">
        <!-- 待接受邀请 -->
        <block wx:if="{{item.myStatus === 'invited'}}">
          <view class="action-btn accept" bindtap="joinTask" data-id="{{item.id}}">接受邀请</view>
          <view class="action-btn reject" bindtap="declineTask" data-id="{{item.id}}">拒绝</view>
        </block>
        
        <!-- 已加入 -->
        <block wx:elif="{{item.myStatus === 'joined'}}">
          <block wx:if="{{item.status === 'active'}}">
            <view class="action-btn primary" bindtap="showCheckInModal" data-id="{{item.id}}" data-type="{{item.type}}">同步打卡</view>
          </block>
          <view class="action-btn" bindtap="leaveTask" data-id="{{item.id}}">退出</view>
        </block>
        
        <!-- 创建者操作 -->
        <block wx:if="{{item.isCreator}}">
          <block wx:if="{{item.status === 'pending'}}">
            <view class="action-btn danger" bindtap="cancelTask" data-id="{{item.id}}">取消</view>
          </block>
          <block wx:if="{{item.status === 'active'}}">
            <view class="action-btn warning" bindtap="completeTask" data-id="{{item.id}}">提前结束</view>
          </block>
          <view class="action-btn danger" bindtap="deleteTask" data-id="{{item.id}}">删除</view>
        </block>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:else>
    <view class="empty-icon">🤝</view>
    <text class="empty-title">还没有打卡任务</text>
    <text class="empty-desc">发起一个任务，邀请好友一起坚持打卡吧</text>
    <button class="btn-primary" bindtap="showCreateModal">发起打卡任务</button>
  </view>
</view>

<!-- 创建任务弹窗 -->
<view class="modal {{showCreateModal ? 'show' : ''}}" catchtouchmove="preventTouchMove">
  <view class="modal-overlay" bindtap="hideCreateModal"></view>
  <view class="modal-panel">
    <view class="modal-header">
      <text class="modal-title">发起打卡任务</text>
      <view class="modal-close" bindtap="hideCreateModal">✕</view>
    </view>
    
    <view class="modal-content">
      <!-- 任务类型 -->
      <view class="form-item">
        <text class="form-label">任务类型</text>
        <view class="type-selector">
          <view class="type-option {{createForm.type === 'fitness' ? 'active' : ''}}" bindtap="onTypeChange" data-value="fitness">
            <text class="type-icon">💪</text>
            <text>健身</text>
          </view>
          <view class="type-option {{createForm.type === 'reading' ? 'active' : ''}}" bindtap="onTypeChange" data-value="reading">
            <text class="type-icon">📖</text>
            <text>读书</text>
          </view>
        </view>
      </view>
      
      <!-- 任务标题 -->
      <view class="form-item">
        <text class="form-label">任务标题 *</text>
        <input class="form-input" value="{{createForm.title}}" bindinput="onTitleInput" placeholder="例如：7天阅读挑战" />
      </view>
      
      <!-- 任务描述 -->
      <view class="form-item">
        <text class="form-label">任务描述</text>
        <input class="form-input" value="{{createForm.description}}" bindinput="onDescInput" placeholder="简单描述一下任务规则（可选）" />
      </view>
      
      <!-- 时间范围 -->
      <view class="form-row">
        <view class="form-item flex-1">
          <text class="form-label">开始日期</text>
          <picker mode="date" value="{{createForm.startDate}}" bindchange="onStartDateChange">
            <view class="form-picker">{{createForm.startDate}}</view>
          </picker>
        </view>
        <view class="form-item flex-1">
          <text class="form-label">结束日期</text>
          <picker mode="date" value="{{createForm.endDate}}" bindchange="onEndDateChange">
            <view class="form-picker">{{createForm.endDate}}</view>
          </picker>
        </view>
      </view>
      
      <!-- 邀请好友 -->
      <view class="form-item">
        <text class="form-label">邀请好友</text>
        <view class="invite-box" bindtap="showFriendSelector">
          <block wx:if="{{createForm.invitees.length === 0}}">
            <text class="invite-placeholder">点击选择要邀请的好友</text>
          </block>
          <block wx:else>
            <view class="invite-list">
              <view class="invite-tag" wx:for="{{createForm.invitees}}" wx:key="*this">
                <text>{{getFriendName(item)}}</text>
              </view>
            </view>
          </block>
          <text class="invite-arrow">›</text>
        </view>
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="btn-primary" bindtap="submitCreate">创建任务</button>
    </view>
  </view>
</view>

<!-- 好友选择器 -->
<view class="modal {{showFriendSelector ? 'show' : ''}}" catchtouchmove="preventTouchMove">
  <view class="modal-overlay" bindtap="hideFriendSelector"></view>
  <view class="modal-panel">
    <view class="modal-header">
      <text class="modal-title">选择好友</text>
      <view class="modal-close" bindtap="hideFriendSelector">✕</view>
    </view>
    
    <view class="modal-content">
      <view class="friend-list" wx:if="{{friends.length > 0}}">
        <view class="friend-item {{createForm.invitees.includes(item.friendId) ? 'selected' : ''}}" 
              wx:for="{{friends}}" 
              wx:key="id"
              bindtap="toggleInvitee"
              data-id="{{item.friendId}}">
          <view class="friend-avatar">
            <text>{{item.username[0]}}</text>
          </view>
          <text class="friend-name">{{item.username}}</text>
          <view class="friend-check" wx:if="{{createForm.invitees.includes(item.friendId)}}">✓</view>
        </view>
      </view>
      
      <view class="empty-state small" wx:else>
        <text class="empty-text">暂无好友，先去添加好友吧</text>
      </view>
    </view>
    
    <view class="modal-footer">
      <button class="btn-primary" bindtap="confirmInvitees">确定 ({{createForm.invitees.length}})</button>
    </view>
  </view>
</view>

<!-- 同步打卡弹窗 -->
<view class="modal {{showCheckInModal ? 'show' : ''}}" catchtouchmove="preventTouchMove">
  <view class="modal-overlay" bindtap="hideCheckInModal"></view>
  <view class="modal-panel">
    <view class="modal-header">
      <text class="modal-title">同步打卡到「{{currentTask.title}}」</text>
      <view class="modal-close" bindtap="hideCheckInModal">✕</view>
    </view>
    
    <view class="modal-content">
      <view class="entry-list" wx:if="{{myEntries.length > 0}}">
        <view class="entry-item {{syncedEntryIds.includes(item.id) ? 'synced' : ''}}" 
              wx:for="{{myEntries}}" 
              wx:key="id"
              bindtap="{{syncedEntryIds.includes(item.id) ? '' : 'syncCheckIn'}}"
              data-id="{{item.id}}"
              data-type="{{currentTask.type}}">
          <view class="entry-info">
            <text class="entry-text">{{item.displayText}}</text>
            <text class="entry-date">{{item.dateStr}}</text>
          </view>
          <view class="entry-status">
            <text wx:if="{{syncedEntryIds.includes(item.id)}}">已同步</text>
            <text wx:else class="sync-btn">同步</text>
          </view>
        </view>
      </view>
      
      <view class="empty-state small" wx:else>
        <text class="empty-text">暂无打卡记录</text>
        <text class="empty-desc">先去健身或读书页面打卡吧</text>
      </view>
    </view>
  </view>
</view>
