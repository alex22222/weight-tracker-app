/* pages/channel/channel.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 头部 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
}

.header-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  padding: 16rpx 28rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.action-icon {
  font-size: 32rpx;
}

/* 任务卡片 */
.task-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.task-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.task-card.pending {
  border-left: 6rpx solid #fbbf24;
}

.task-card.active {
  border-left: 6rpx solid #10b981;
}

.task-card.completed {
  border-left: 6rpx solid #64748b;
  opacity: 0.8;
}

.task-card.cancelled {
  border-left: 6rpx solid #ef4444;
  opacity: 0.6;
}

.task-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.task-type-icon {
  font-size: 48rpx;
  width: 88rpx;
  height: 88rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-info {
  flex: 1;
  min-width: 0;
}

.task-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
}

.task-desc {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.task-meta {
  display: flex;
  gap: 20rpx;
}

.task-date, .task-members {
  font-size: 24rpx;
  color: #94a3b8;
}

.task-status-badge {
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  height: fit-content;
}

.task-status-badge.pending {
  background: #fef3c7;
  color: #d97706;
}

.task-status-badge.active {
  background: #d1fae5;
  color: #059669;
}

.task-status-badge.completed {
  background: #f1f5f9;
  color: #64748b;
}

.task-status-badge.cancelled {
  background: #fee2e2;
  color: #dc2626;
}

.task-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f1f5f9;
}

.action-btn {
  flex: 1;
  padding: 20rpx;
  background: #f1f5f9;
  color: #475569;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  font-weight: 500;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

.action-btn.accept {
  background: #d1fae5;
  color: #059669;
}

.action-btn.reject {
  background: #fee2e2;
  color: #dc2626;
}

.action-btn.warning {
  background: #fef3c7;
  color: #d97706;
}

.action-btn.danger {
  background: #fee2e2;
  color: #dc2626;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
  gap: 20rpx;
}

.empty-state.small {
  padding: 60rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.empty-desc {
  font-size: 26rpx;
  color: #94a3b8;
  text-align: center;
}

.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border: none;
  border-radius: 32rpx;
  padding: 24rpx 48rpx;
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 20rpx;
}

.btn-primary::after {
  border: none;
}

/* 弹窗 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
  opacity: 0;
  transition: all 0.3s ease;
}

.modal.show {
  visibility: visible;
  opacity: 1;
}

.modal-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  max-height: 85vh;
  transform: translateY(100%);
  transition: transform 0.3s ease;
  display: flex;
  flex-direction: column;
}

.modal.show .modal-panel {
  transform: translateY(0);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1e293b;
}

.modal-close {
  font-size: 36rpx;
  color: #94a3b8;
  padding: 8rpx;
}

.modal-content {
  padding: 24rpx 32rpx;
  max-height: 60vh;
  overflow-y: auto;
  flex: 1;
}

.modal-footer {
  padding: 24rpx 32rpx 48rpx;
  border-top: 2rpx solid #f1f5f9;
}

/* 表单 */
.form-item {
  margin-bottom: 24rpx;
}

.form-row {
  display: flex;
  gap: 20rpx;
}

.flex-1 {
  flex: 1;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #475569;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #1e293b;
  box-sizing: border-box;
}

.form-picker {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #1e293b;
}

/* 类型选择器 */
.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  padding: 32rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  border: 4rpx solid transparent;
  transition: all 0.2s;
}

.type-option.active {
  border-color: #667eea;
  background: #f0f9ff;
}

.type-icon {
  font-size: 48rpx;
}

.type-option text:last-child {
  font-size: 28rpx;
  color: #475569;
  font-weight: 500;
}

/* 邀请框 */
.invite-box {
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.invite-placeholder {
  font-size: 28rpx;
  color: #94a3b8;
}

.invite-count {
  font-size: 28rpx;
  color: #667eea;
  font-weight: 500;
}

.invite-arrow {
  font-size: 32rpx;
  color: #94a3b8;
}

/* 好友列表 */
.friend-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.friend-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
}

.friend-item.selected {
  border-color: #667eea;
  background: #f0f9ff;
}

.friend-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.friend-name {
  flex: 1;
  font-size: 28rpx;
  color: #1e293b;
}

.friend-check {
  width: 40rpx;
  height: 40rpx;
  background: #667eea;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
}

/* 打卡记录列表 */
.entry-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.entry-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 12rpx;
}

.entry-item.synced {
  opacity: 0.6;
}

.entry-info {
  flex: 1;
  min-width: 0;
}

.entry-text {
  font-size: 28rpx;
  color: #1e293b;
  display: block;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-date {
  font-size: 24rpx;
  color: #94a3b8;
}

.entry-status {
  font-size: 26rpx;
  color: #94a3b8;
}

.sync-btn {
  padding: 12rpx 32rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
}
