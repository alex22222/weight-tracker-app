<!--pages/channel/detail.wxml-->
<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">‹</view>
    <text class="nav-title">任务详情</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{isLoading}}">
    <text>加载中...</text>
  </view>

  <!-- 任务详情 -->
  <block wx:if="{{!isLoading && task}}">
    <!-- 任务信息卡片 -->
    <view class="task-info-card">
      <view class="task-type-header">
        <view class="type-icon-large">{{task.type === 'fitness' ? '💪' : '📖'}}</view>
        <view class="task-main-info">
          <text class="task-title-large">{{task.title}}</text>
          <view class="task-status-row">
            <text class="status-badge {{task.status}}">
              {{task.status === 'pending' ? '待开始' : task.status === 'active' ? '进行中' : task.status === 'completed' ? '已结束' : '已取消'}}
            </text>
            <text class="task-creator">发起人: {{task.isCreator ? '我' : '好友'}}</text>
          </view>
        </view>
      </view>
      
      <view class="task-desc-block" wx:if="{{task.description}}">
        <text>{{task.description}}</text>
      </view>
      
      <view class="task-time-block">
        <view class="time-item">
          <text class="time-label">开始时间</text>
          <text class="time-value">{{formatDate(task.startDate)}}</text>
        </view>
        <view class="time-arrow">→</view>
        <view class="time-item">
          <text class="time-label">结束时间</text>
          <text class="time-value">{{formatDate(task.endDate)}}</text>
        </view>
      </view>
    </view>

    <!-- 排行榜 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-title">
          <text class="title-icon">🏆</text>
          <text>打卡排行榜</text>
        </view>
        <text class="section-subtitle" wx:if="{{myRank > 0}}">我的排名: 第{{myRank}}名</text>
      </view>
      
      <view class="ranking-list">
        <view class="rank-item {{item.rank <= 3 ? 'top' : ''}} {{item.isMe ? 'me' : ''}}" 
              wx:for="{{ranking}}" 
              wx:key="userId">
          <view class="rank-number {{item.rank <= 3 ? 'top' + item.rank : ''}}">{{item.rank}}</view>
          <view class="rank-avatar">
            <text>{{item.username[0]}}</text>
          </view>
          <view class="rank-info">
            <text class="rank-name">{{item.username}} {{item.isMe ? '(我)' : ''}}</text>
            <text class="rank-count">{{item.checkInCount}} 次打卡</text>
          </view>
          <view class="rank-medal" wx:if="{{item.rank <= 3}}">
            {{item.rank === 1 ? '🥇' : item.rank === 2 ? '🥈' : '🥉'}}
          </view>
        </view>
      </view>
    </view>

    <!-- 打卡动态 -->
    <view class="section-card">
      <view class="section-header">
        <view class="section-title">
          <text class="title-icon">📋</text>
          <text>打卡动态</text>
        </view>
      </view>
      
      <view class="checkin-list" wx:if="{{checkIns.length > 0}}">
        <view class="checkin-item" wx:for="{{checkIns}}" wx:key="id">
          <view class="checkin-avatar">
            <text>{{item.username[0]}}</text>
          </view>
          <view class="checkin-body">
            <view class="checkin-header">
              <text class="checkin-user">{{item.username}}</text>
              <text class="checkin-time">{{formatTime(item.checkedAt)}}</text>
            </view>
            <view class="checkin-content">
              <text class="checkin-icon">{{item.entryType === 'weight' ? '⚖️' : '📖'}}</text>
              <block wx:if="{{item.entryType === 'weight'}}">
                <text>记录了体重 {{item.detail?.weight}} kg</text>
                <text wx:if="{{item.detail?.note}}" class="checkin-note">{{item.detail.note}}</text>
              </block>
              <block wx:else>
                <text>阅读了《{{item.detail?.bookName}}》{{item.detail?.pages}} 页</text>
                <text wx:if="{{item.detail?.note}}" class="checkin-note">{{item.detail.note}}</text>
              </block>
            </view>
          </view>
        </view>
      </view>
      
      <view class="empty-state small" wx:else>
        <text class="empty-text">暂无打卡动态</text>
      </view>
    </view>
  </block>
</view>
