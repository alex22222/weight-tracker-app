/* pages/channel/detail.wxss */
.container {
  padding: 20rpx;
  padding-bottom: 40rpx;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}

.nav-back {
  font-size: 48rpx;
  color: #1e293b;
  padding: 0 20rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1e293b;
}

.nav-placeholder {
  width: 88rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 100rpx;
  color: #94a3b8;
  font-size: 28rpx;
}

/* 任务信息卡片 */
.task-info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.task-type-header {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.type-icon-large {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
}

.task-main-info {
  flex: 1;
  min-width: 0;
}

.task-title-large {
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  display: block;
  margin-bottom: 12rpx;
}

.task-status-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.status-badge.pending {
  background: #fef3c7;
  color: #d97706;
}

.status-badge.active {
  background: #fff7ed;
  color: #f97316;
}

.status-badge.completed {
  background: #f1f5f9;
  color: #64748b;
}

.status-badge.cancelled {
  background: #fee2e2;
  color: #dc2626;
}

.task-creator {
  font-size: 26rpx;
  color: #64748b;
}

.task-desc-block {
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.task-time-block {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  background: #f0f9ff;
  border-radius: 12rpx;
}

.time-item {
  text-align: center;
}

.time-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.time-value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.time-arrow {
  font-size: 32rpx;
  color: #94a3b8;
}

/* 区块卡片 */
.section-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.title-icon {
  font-size: 36rpx;
}

.section-subtitle {
  font-size: 26rpx;
  color: #f97316;
  font-weight: 500;
}

/* 排行榜 */
.ranking-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.rank-item.top {
  background: linear-gradient(135deg, #fef9c3 0%, #fef3c7 100%);
}

.rank-item.me {
  border: 4rpx solid #f97316;
}

.rank-number {
  width: 48rpx;
  height: 48rpx;
  background: #e2e8f0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #64748b;
}

.rank-number.top1 {
  background: linear-gradient(135deg, #fcd34d 0%, #fbbf24 100%);
  color: #92400e;
}

.rank-number.top2 {
  background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
  color: #4b5563;
}

.rank-number.top3 {
  background: linear-gradient(135deg, #fdba74 0%, #fb923c 100%);
  color: #7c2d12;
}

.rank-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
}

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
  margin-bottom: 4rpx;
}

.rank-count {
  font-size: 24rpx;
  color: #64748b;
}

.rank-medal {
  font-size: 48rpx;
}

/* 打卡动态 */
.checkin-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.checkin-item {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 16rpx;
}

.checkin-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f97316 0%, #ea580c 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.checkin-body {
  flex: 1;
  min-width: 0;
}

.checkin-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.checkin-user {
  font-size: 28rpx;
  font-weight: 600;
  color: #1e293b;
}

.checkin-time {
  font-size: 24rpx;
  color: #94a3b8;
}

.checkin-content {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.5;
}

.checkin-icon {
  font-size: 32rpx;
}

.checkin-note {
  width: 100%;
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  gap: 16rpx;
}

.empty-state.small {
  padding: 40rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #94a3b8;
}
