# 使用 Node.js 18 官方镜像
FROM node:18-alpine

# 设置工作目录
WORKDIR /app

# 复制 package.json
COPY package.json ./

# 安装生产依赖（使用 --production 跳过 devDependencies）
RUN npm install --production

# 复制已构建的 standalone 目录
COPY .next/standalone ./
COPY .next/static ./.next/static
COPY public ./public

# 设置环境变量
ENV NODE_ENV=production
ENV PORT=80
ENV HOSTNAME=0.0.0.0

# 暴露端口
EXPOSE 80

# 启动命令
CMD ["node", "server.js"]
