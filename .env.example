# ============================================
# 核心配置（必须）
# ============================================

# JWT 密钥（用于 Token 签名，生产环境必须修改）
JWT_SECRET=your-jwt-secret-key-change-in-production

# 数据库配置
# 可选值: prisma (本地开发) 或 cloudbase (生产环境)
DB_TYPE=cloudbase

# CloudBase 环境 ID
# 在 CloudBase 控制台获取: https://tcb.cloud.tencent.com/
CLOUDBASE_ENV_ID=your-env-id-here

# 腾讯云 API 凭证（服务器端访问 CloudBase）
TENCENTCLOUD_SECRETID=your-secret-id
TENCENTCLOUD_SECRETKEY=your-secret-key

# ============================================
# 微信登录配置（必须，如果使用微信登录）
# ============================================

# 微信小程序 AppID 和 Secret
# 在微信公众平台获取: https://mp.weixin.qq.com/
WECHAT_APPID=your-wechat-appid-here
WECHAT_SECRET=your-wechat-secret-here

# ============================================
# SMTP 邮件配置（可选，用于邮箱注册/找回密码）
# ============================================

# 邮件服务器配置示例（163邮箱）
# SMTP_HOST=smtp.163.com
# SMTP_PORT=587
# SMTP_USER=your-email@163.com
# SMTP_PASS=your-email-password
# SMTP_FROM=your-email@163.com
# SMTP_SECURE=false

# ============================================
# 可选配置
# ============================================

# Prisma 数据库 URL（仅本地开发使用 prisma 时）
DATABASE_URL="file:./dev.db"

# Next.js 配置
NODE_ENV=development
PORT=3000

# ============================================
# L1 全量备份配置（可选）
# ============================================

# 备份存储目录（默认: ./backups）
BACKUP_DIR=./backups

# 备份保留天数（默认: 30）
BACKUP_RETENTION_DAYS=30

# CORS 允许的域名（逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,https://www.spaceflag.site
