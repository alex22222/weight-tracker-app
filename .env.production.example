# 生产环境环境变量配置
# 复制此文件为 .env.production 并填入实际值

# ==================== 必填项 ====================

# JWT 密钥（必须设置强密码，至少32位随机字符串）
JWT_SECRET=your-strong-random-secret-key-min-32-chars

# 腾讯云 CloudBase 环境 ID
CLOUDBASE_ENV_ID=weight-tracker-1ghr085dd7d6cff2

# 腾讯云 API 密钥（CloudRun 会自动注入，也可手动设置）
TCB_SECRET_ID=your-tencent-secret-id
TCB_SECRET_KEY=your-tencent-secret-key

# ==================== 微信小程序配置 ====================

# 微信小程序 AppID
WECHAT_APPID=your-wechat-appid

# 微信小程序 AppSecret
WECHAT_SECRET=your-wechat-appsecret

# ==================== 安全配置 ====================

# 允许的跨域域名（多个用逗号分隔）
ALLOWED_ORIGINS=https://api.spaceflag.site,https://spaceflag.site

# JWT Token 过期时间
JWT_EXPIRES_IN=7d

# Node 环境
NODE_ENV=production

# ==================== 可选配置 ====================

# 数据库类型（prisma 或 cloudbase，默认 cloudbase）
DB_TYPE=cloudbase

# 管理员重置密钥（用于重置 admin 密码）
ADMIN_RESET_KEY=your-secure-reset-key
